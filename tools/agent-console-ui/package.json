{
  "name": "@footballos/agent-console-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Agent Build Console UI: owner-only localhost view of the Claude Code agents building FootballOS. Served by @footballos/agent-console from ./dist.",
  "scripts": {
    "dev": "vite --port 4801 --strictPort",
    "dev:mock": "node scripts/dev-mock.mjs",
    "mock": "node scripts/mock-server.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4801",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
