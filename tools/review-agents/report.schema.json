{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FootballOS simulated staff usability review",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "disclaimer": {
      "const": "These are simulated-persona reviews generated by AI agents, not interviews with real coaches. They supplement rather than replace human feedback."
    },
    "role": {
      "type": "string",
      "enum": [
        "head_coach",
        "coordinator",
        "position_coach"
      ]
    },
    "round": {
      "type": "string",
      "enum": [
        "round-1",
        "round-2"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "phase_0": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "set_at": {
          "type": "string",
          "format": "date-time"
        },
        "role_task_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([GHCP][1-7]|W1)$"
          },
          "minItems": 7
        },
        "unaided_percent_min": {
          "const": 80
        },
        "data_loss_max": {
          "const": 0
        },
        "evidence_interactions_max": {
          "const": 2
        },
        "would_use_target": {
          "const": "yes"
        }
      },
      "required": [
        "set_at",
        "role_task_ids",
        "unaided_percent_min",
        "data_loss_max",
        "evidence_interactions_max",
        "would_use_target"
      ]
    },
    "success_criteria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role_tasks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "met": {
              "type": "boolean"
            },
            "unaided": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "met",
            "unaided",
            "total"
          ]
        },
        "data_loss": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "met": {
              "type": "boolean"
            },
            "finding_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(HC|OC|PC)-[0-9]{2,}$"
              },
              "minItems": 0
            }
          },
          "required": [
            "met",
            "finding_ids"
          ]
        },
        "ai_evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "met": {
              "type": "boolean"
            },
            "within_budget": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "met",
            "within_budget",
            "total"
          ]
        },
        "would_use": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "met": {
              "type": "boolean"
            },
            "answer": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "conditional"
              ]
            }
          },
          "required": [
            "met",
            "answer"
          ]
        },
        "overall_met": {
          "type": "boolean"
        }
      },
      "required": [
        "role_tasks",
        "data_loss",
        "ai_evidence",
        "would_use",
        "overall_met"
      ]
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "live_ui": {
          "type": "boolean"
        },
        "source_review": {
          "type": "boolean"
        },
        "tests_run": {
          "type": "boolean"
        }
      },
      "required": [
        "live_ui",
        "source_review",
        "tests_run"
      ]
    },
    "expectations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 3,
      "maxItems": 3
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      },
      "minItems": 12,
      "maxItems": 13
    },
    "input_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^([GHCP][1-7]|W1)$"
          },
          "probe": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "preserved",
              "warned",
              "lost",
              "unverified"
            ]
          },
          "finding_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(HC|OC|PC)-[0-9]{2,}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          }
        },
        "required": [
          "task_id",
          "probe",
          "result",
          "finding_id",
          "evidence"
        ]
      },
      "minItems": 1
    },
    "ai_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^([GHCP][1-7]|W1)$"
              },
              "output": {
                "type": "string",
                "minLength": 1
              },
              "route": {
                "type": "string",
                "pattern": "^/"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "result": {
                "type": "string",
                "enum": [
                  "reached",
                  "missing",
                  "wrong_target",
                  "unverified"
                ]
              },
              "observed": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "$ref": "#/$defs/evidence"
              }
            },
            "required": [
              "task_id",
              "output",
              "route",
              "count",
              "actions",
              "result",
              "observed",
              "evidence"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "complete",
        "scope",
        "checks"
      ]
    },
    "interview": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "q": {
            "type": "integer",
            "minimum": 1,
            "maximum": 13
          },
          "answer": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "q",
          "answer"
        ]
      },
      "minItems": 13,
      "maxItems": 13
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "keep": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "would_use": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "conditional"
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "would_recommend": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "conditional"
          ]
        }
      },
      "required": [
        "would_use",
        "condition",
        "would_recommend"
      ]
    },
    "learnings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worked": {
          "type": "string",
          "minLength": 1
        },
        "did_not": {
          "type": "string",
          "minLength": 1
        },
        "try_next": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "worked",
        "did_not",
        "try_next"
      ]
    }
  },
  "required": [
    "disclaimer",
    "role",
    "round",
    "generated_at",
    "phase_0",
    "success_criteria",
    "method",
    "expectations",
    "tasks",
    "input_checks",
    "ai_evidence",
    "interview",
    "findings",
    "keep",
    "verdict",
    "learnings"
  ],
  "$defs": {
    "evidence": {
      "type": "string",
      "pattern": "^(ui: evidence/.+\\.png|source: [^\\r\\n]+:[1-9][0-9]*)$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^([GHCP][1-7]|W1)$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "completion": {
          "type": "string",
          "enum": [
            "unaided",
            "with_help",
            "wrong",
            "abandoned"
          ]
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "attempted": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage"
          },
          "minItems": 3
        }
      },
      "required": [
        "id",
        "title",
        "completion",
        "steps",
        "attempted",
        "observed",
        "evidence",
        "note"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "W1"
              }
            }
          },
          "then": {
            "required": [
              "context",
              "stages"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "context"
                  ]
                },
                {
                  "required": [
                    "stages"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(HC|OC|PC)-[0-9]{2,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "string",
          "pattern": "^/"
        },
        "element": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "blocker",
            "major",
            "minor",
            "cosmetic"
          ]
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "proposed_change": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "urgency": {
          "$ref": "#/$defs/level"
        },
        "value": {
          "$ref": "#/$defs/level"
        },
        "weekly_cost": {
          "type": "string",
          "minLength": 1
        },
        "moscow": {
          "type": "string",
          "enum": [
            "must",
            "should",
            "could",
            "wont"
          ]
        },
        "stakeholder": {
          "type": "string",
          "enum": [
            "head_coach",
            "athletic_director",
            "coordinator",
            "none"
          ]
        },
        "data_loss": {
          "type": "boolean"
        },
        "cost_of_delay": {
          "type": "integer",
          "enum": [
            1,
            2,
            3,
            4,
            6,
            9
          ]
        }
      },
      "required": [
        "id",
        "title",
        "route",
        "element",
        "severity",
        "observed",
        "expected",
        "evidence",
        "proposed_change",
        "quote",
        "rank",
        "urgency",
        "value",
        "weekly_cost",
        "moscow",
        "stakeholder",
        "data_loss",
        "cost_of_delay"
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "required": [
        "id",
        "steps",
        "observed",
        "evidence"
      ]
    }
  }
}
