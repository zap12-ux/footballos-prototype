{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FootballOS simulated staff usability review",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "disclaimer": {
      "const": "These are simulated-persona reviews generated by AI agents, not interviews with real coaches. They supplement rather than replace human feedback."
    },
    "role": {
      "type": "string",
      "enum": [
        "head_coach",
        "coordinator",
        "position_coach"
      ]
    },
    "round": {
      "type": "string",
      "enum": [
        "round-1",
        "round-2"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "live_ui": {
          "type": "boolean"
        },
        "source_review": {
          "type": "boolean"
        },
        "tests_run": {
          "type": "boolean"
        }
      },
      "required": [
        "live_ui",
        "source_review",
        "tests_run"
      ]
    },
    "expectations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 3,
      "maxItems": 3
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      },
      "minItems": 11,
      "maxItems": 12
    },
    "interview": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "q": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "answer": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "q",
          "answer"
        ]
      },
      "minItems": 10,
      "maxItems": 10
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "keep": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "would_use": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "conditional"
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "would_recommend": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "conditional"
          ]
        }
      },
      "required": [
        "would_use",
        "condition",
        "would_recommend"
      ]
    }
  },
  "required": [
    "disclaimer",
    "role",
    "round",
    "generated_at",
    "method",
    "expectations",
    "tasks",
    "interview",
    "findings",
    "keep",
    "verdict"
  ],
  "$defs": {
    "evidence": {
      "type": "string",
      "pattern": "^(ui: evidence/.+\\.png|source: [^\\r\\n]+:[1-9][0-9]*)$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[GHCP][1-7]$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "completion": {
          "type": "string",
          "enum": [
            "unaided",
            "with_help",
            "wrong",
            "abandoned"
          ]
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "attempted": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "completion",
        "steps",
        "attempted",
        "observed",
        "evidence",
        "note"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(HC|OC|PC)-[0-9]{2,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "string",
          "pattern": "^/"
        },
        "element": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "blocker",
            "major",
            "minor",
            "cosmetic"
          ]
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "proposed_change": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "title",
        "route",
        "element",
        "severity",
        "observed",
        "expected",
        "evidence",
        "proposed_change",
        "quote",
        "rank"
      ]
    }
  }
}
