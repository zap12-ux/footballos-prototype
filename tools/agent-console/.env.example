# Agent Build Console — local development settings (no secrets here).
# Copy to .env and export, or set in the shell before `npm run console`.

# TCP port on 127.0.0.1 the console listens on.
CONSOLE_PORT=4800

# Where console.db and owner-token live. Default: <repo root>/.data/console (gitignored).
CONSOLE_DATA_DIR=

# Minutes without an agent/runtime update before a working agent is shown as `disconnected`.
STALE_AFTER_MIN=20

# Seconds a submitted response may sit unfetched before it appears in GET /api/lead/inbox.
LEAD_PICKUP_AFTER_SEC=90

# Git repository root used by GET /api/git/agents/:agentId. Default: the repo containing this package.
CONSOLE_REPO_ROOT=
