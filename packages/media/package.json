{
  "name": "@footballos/media",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Film validation, playback proxies, thumbnails, proposed play boundaries, footage-quality assessment and store-agnostic job-runner semantics for FootballOS. Hosted by the API job worker.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "footballos-media": "bin/media.mjs"
  },
  "scripts": {
    "contracts:build": "npm run build --prefix ../../packages/contracts",
    "pretypecheck": "npm run contracts:build",
    "pretest": "npm run contracts:build",
    "prebuild": "npm run contracts:build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly"
  },
  "dependencies": {
    "@footballos/contracts": "0.1.0",
    "@napi-rs/canvas": "^1.0.13",
    "@tesseract.js-data/eng": "^1.0.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "bin"
  ]
}
