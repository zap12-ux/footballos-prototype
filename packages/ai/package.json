{
  "name": "@footballos/ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FootballOS applied-AI library: vision labeling over a local Ollama server (open-source vision model), frame-sampling plans, deterministic scouting statistics, playbook proposals, recommendations, and an evaluation harness for coach-labeled footage.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "footballos-ai-eval": "bin/eval.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/prompts/*.md dist/prompts/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval": "node bin/eval.mjs",
    "contracts:build": "npm run build --prefix ../contracts",
    "prebuild": "npm run contracts:build",
    "pretypecheck": "npm run contracts:build",
    "pretest": "npm run contracts:build"
  },
  "dependencies": {
    "@footballos/contracts": "0.1.0",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
