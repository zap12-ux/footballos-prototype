{
  "name": "@footballos/ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FootballOS applied-AI library: replaceable vision-labeling adapter (Anthropic primary), frame-sampling plans, deterministic scouting statistics, and an evaluation harness for coach-labeled footage.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "footballos-ai-eval": "bin/eval.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -R src/prompts dist/prompts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval": "node bin/eval.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
