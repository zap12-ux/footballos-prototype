# Template, unverified: adopt once apps/api defines its production entry point.
# Install to /etc/systemd/system/, then: systemctl daemon-reload && systemctl enable --now footballos-api
[Unit]
Description=FootballOS API and background worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=footballos
Group=footballos
WorkingDirectory=/opt/footballos/current
EnvironmentFile=/etc/footballos/api.env
# Placeholder: replace with the API's production start command.
ExecStart=/usr/bin/node apps/api/dist/server.js
Restart=on-failure
RestartSec=5
# Gives in-flight jobs time to release their leases before shutdown.
TimeoutStopSec=60

# Hardening: everything is read-only except the data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/footballos
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
