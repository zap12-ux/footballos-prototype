# FootballOS API environment template. Copy to /etc/footballos/api.env (mode 0600) on the host,
# or to apps/api/.env for local development. Never commit filled-in values.
# Proposal for the backend owner to adopt; variable names are not final until apps/api reads them.

# Runtime
NODE_ENV=production
# Environment label shown in the UI: development | demo | production
FOOTBALLOS_ENV=production
PORT=8787
# Bind to loopback; the reverse proxy terminates TLS.
HOST=127.0.0.1
# Database, media and backups live here. Use a separate directory per environment and per worker.
FOOTBALLOS_DATA_DIR=/var/lib/footballos
# Public origin used for cookies, CORS and expiring media links.
PUBLIC_ORIGIN=https://footballos.example.org

# Sessions: at least 32 random bytes, e.g. `openssl rand -base64 48`.
SESSION_SECRET=
SESSION_TTL_HOURS=12

# Model provider: anthropic | openai | none (none = manual review only, no inference calls)
MODEL_PROVIDER=none
# Keys are used server-side only. Use API keys billed separately from consumer subscriptions.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Exact model id recorded in label provenance (read by apps/api). Keep equal to
# FOOTBALLOS_AI_MODEL below until the two settings are merged.
MODEL_ID=

# AI labeling (read by packages/ai; empty values use the package defaults shown).
# Model id sent to the Anthropic Messages API.
FOOTBALLOS_AI_MODEL=claude-opus-5-5
# Thinking effort per labeling call: low | medium | high | xhigh | max. Higher costs more.
FOOTBALLOS_AI_EFFORT=medium
# Upper bound on response tokens per labeling call.
FOOTBALLOS_AI_MAX_OUTPUT_TOKENS=4096
# A single analysis job aborts once its estimated spend reaches this (USD). The overall
# month-to-date limit is MONTHLY_COST_CAP_USD below, which still applies.
FOOTBALLOS_AI_JOB_BUDGET_USD=25
# Frames sent to the model per play segment (read by packages/ai). apps/api reads
# MAX_FRAMES_PER_SEGMENT for the same limit; keep the two equal until they are merged.
FOOTBALLOS_AI_MAX_FRAMES_PER_SEGMENT=12
# Play segments a single analysis job may label before it stops.
FOOTBALLOS_AI_MAX_SEGMENTS_PER_JOB=200
# Per-request timeout for model calls, in milliseconds.
FOOTBALLOS_AI_REQUEST_TIMEOUT_MS=120000

# Media binaries (read by packages/media). Leave empty to use the bundled ffmpeg-static and
# ffprobe-static binaries; set absolute paths to use a system install instead.
FOOTBALLOS_FFMPEG=
FOOTBALLOS_FFPROBE=

# Upload limits
MAX_UPLOAD_BYTES=21474836480
UPLOAD_CHUNK_BYTES=16777216
ALLOWED_VIDEO_CONTAINERS=mp4,mov,mkv

# Processing limits
WORKER_CONCURRENCY=1
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=300
# Maximum frames sent to the model per play segment (read by apps/api; see
# FOOTBALLOS_AI_MAX_FRAMES_PER_SEGMENT above).
MAX_FRAMES_PER_SEGMENT=12

# Cost control, overall cap: inference jobs stop and report "budget reached" once month-to-date
# provider spend reaches this cap. 0 disables paid inference. Applies on top of the per-job
# FOOTBALLOS_AI_JOB_BUDGET_USD.
MONTHLY_COST_CAP_USD=0

# Logging: info | warn | error. Logs must never include secrets, tokens or uploaded content.
LOG_LEVEL=info
