# FootballOS API environment template. Copy to /etc/footballos/api.env (mode 0600) on the host,
# or to apps/api/.env for local development. Never commit filled-in values.
# Proposal for the backend owner to adopt; variable names are not final until apps/api reads them.

# Runtime
NODE_ENV=production
# Environment label shown in the UI: development | demo | production
FOOTBALLOS_ENV=production
PORT=8787
# Bind to loopback; the reverse proxy terminates TLS.
HOST=127.0.0.1
# Database, media and backups live here. Use a separate directory per environment and per worker.
FOOTBALLOS_DATA_DIR=/var/lib/footballos
# Public origin used for cookies, CORS and expiring media links.
PUBLIC_ORIGIN=https://footballos.example.org

# Sessions: at least 32 random bytes, e.g. `openssl rand -base64 48`.
SESSION_SECRET=
SESSION_TTL_HOURS=12

# Model: a local Ollama server on the same host (or a private network neighbour) running an
# open-source vision model. No API key, no per-call cost. Install Ollama, then on the server:
#   ollama pull qwen3-vl:8b        (16 GiB+ RAM; use qwen3-vl:4b on 8 GiB)
# Bind Ollama to loopback or a private interface only; it has no authentication of its own.
OLLAMA_HOST=http://127.0.0.1:11434
# Any Ollama model tag with the "vision" capability; recorded in every label's provenance.
FOOTBALLOS_AI_MODEL=qwen3-vl:8b
# Upper bound on response tokens per labeling call (Ollama num_predict).
FOOTBALLOS_AI_MAX_OUTPUT_TOKENS=4096
# Frames sent to the model per play segment.
FOOTBALLOS_AI_MAX_FRAMES_PER_SEGMENT=12
# Play segments a single analysis job may label before it stops.
FOOTBALLOS_AI_MAX_SEGMENTS_PER_JOB=200
# Per-request timeout for model calls, in milliseconds (CPU inference is slow; GPU hosts can lower this).
FOOTBALLOS_AI_REQUEST_TIMEOUT_MS=300000
# Upper bound on the per-call context window (num_ctx). Each call is sized to its frames (about 1 400 tokens
# per image plus the answer) and capped here; 12 frames need about 24K. Lower it on machines with little RAM.
FOOTBALLOS_AI_MAX_NUM_CTX=32768
# How long Ollama keeps the model loaded between calls.
FOOTBALLOS_AI_KEEP_ALIVE=10m

# Media binaries (read by packages/media). Leave empty to use the bundled ffmpeg-static and
# ffprobe-static binaries; set absolute paths to use a system install instead.
FOOTBALLOS_FFMPEG=
FOOTBALLOS_FFPROBE=

# Upload limits
MAX_UPLOAD_BYTES=21474836480
UPLOAD_CHUNK_BYTES=16777216
ALLOWED_VIDEO_CONTAINERS=mp4,mov,mkv

# Processing limits
WORKER_CONCURRENCY=1
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=300
# Logging: info | warn | error. Logs must never include secrets, tokens or uploaded content.
LOG_LEVEL=info
