# FootballOS API environment template with DEVELOPMENT defaults. Copy to apps/api/.env for local work;
# deploy/env/api.env.example holds the production template. Never commit filled-in values.

# Runtime
NODE_ENV=development
# Environment label shown in the UI: development | demo | research | production
FOOTBALLOS_ENV=development
PORT=8787
# Bind to loopback; the reverse proxy terminates TLS.
HOST=127.0.0.1
# Database, media and backups live here. Use a separate directory per environment and per worker.
FOOTBALLOS_DATA_DIR=.data/dev
# Public origin used for cookies, CORS and expiring media links.
PUBLIC_ORIGIN=http://localhost:5173

# Sessions: at least 32 random bytes, e.g. `openssl rand -base64 48`.
# Development falls back to a fixed insecure secret when this is empty; production refuses to start.
SESSION_SECRET=
# Idle timeout (hours) and absolute lifetime (days) of a session cookie.
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_DAYS=30
# Set to true behind TLS so the fos_session cookie carries the Secure flag.
COOKIE_SECURE=false

# Model: a local Ollama server running an open-source vision model. No API key, no per-call cost.
# Install Ollama (https://ollama.com), then pull the model once:  ollama pull qwen3-vl:4b
# Settings are read by @footballos/ai (loadAiConfig) so provenance records the model actually called.
OLLAMA_HOST=http://127.0.0.1:11434
# Any Ollama model tag with the "vision" capability. qwen3-vl:4b fits an 8 GiB machine;
# use qwen3-vl:8b on a server with 16 GiB or more.
FOOTBALLOS_AI_MODEL=qwen3-vl:4b
# Upper bound on response tokens per labeling call (Ollama num_predict).
FOOTBALLOS_AI_MAX_OUTPUT_TOKENS=4096
FOOTBALLOS_AI_MAX_FRAMES_PER_SEGMENT=12
# Segments per infer_labels job; POST /assets/:id/infer splits larger requests into several jobs.
FOOTBALLOS_AI_MAX_SEGMENTS_PER_JOB=200
# Local CPU inference over a dozen frames can take minutes; this is the per-call timeout.
FOOTBALLOS_AI_REQUEST_TIMEOUT_MS=300000
# Upper bound on the per-call context window (num_ctx). Each call is sized to its frames (about 1 400 tokens
# per image plus the answer) and capped here; 12 frames need about 24K. Lower it on machines with little RAM.
FOOTBALLOS_AI_MAX_NUM_CTX=32768
# How long Ollama keeps the model loaded between calls.
FOOTBALLOS_AI_KEEP_ALIVE=10m

# Upload limits
MAX_UPLOAD_BYTES=21474836480
UPLOAD_CHUNK_BYTES=16777216
ALLOWED_VIDEO_CONTAINERS=mp4,mov,mkv
# Incomplete uploads and their partial files are garbage-collected after this many hours.
UPLOAD_TTL_HOURS=24
# Lifetime of signed media stream/thumbnail grants (minutes, at most 15).
MEDIA_GRANT_TTL_MIN=15

# Job worker. WORKER_INLINE=true runs the worker inside the API process (development);
# otherwise run `npm run worker -w apps/api` as a separate process against the same data directory.
WORKER_INLINE=true
WORKER_CONCURRENCY=1
WORKER_POLL_MS=1000
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=300
# Maintenance tick (seconds): recovers expired job leases (a job orphaned by a crashed worker is
# re-queued without a restart), garbage-collects expired uploads and applies retention.
WORKER_MAINTENANCE_SEC=60
# Playback proxy height and thumbnail spacing.
PROXY_HEIGHT=720
THUMBNAIL_EVERY_SEC=10
# Playbook documents (Milestone C): size cap, accepted extensions, page render DPI and OCR mode
# (auto = OCR pages without a text layer when the offline engine is installed; off = never).
MAX_DOCUMENT_BYTES=104857600
ALLOWED_DOCUMENT_TYPES=pdf,txt,md
DOCUMENT_RENDER_DPI=110
DOCUMENT_OCR=auto
# Optional absolute paths to host ffmpeg/ffprobe builds; otherwise the bundled ffmpeg-static/ffprobe-static binaries are used.
FOOTBALLOS_FFMPEG=
FOOTBALLOS_FFPROBE=

# Logging: debug | info | warn | error | silent. Logs must never include secrets, tokens or uploaded content.
# Exception, by design: in development/demo environments the account-recovery token is written to the log
# because no mail provider exists yet. Never in research/production.
LOG_LEVEL=info

# Sign-in and MFA attempt limits (in-memory, per client IP + e-mail).
SIGN_IN_RATE_LIMIT_MAX=10
SIGN_IN_RATE_LIMIT_WINDOW_SEC=900
# Invite and recovery-token lifetimes.
INVITE_TTL_HOURS=168
RECOVERY_TOKEN_TTL_MINUTES=60
