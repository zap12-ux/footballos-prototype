{
  "name": "footballos",
  "private": true,
  "version": "0.2.0",
  "description": "FootballOS: private AI-assisted coaching workspace for one football staff. npm-workspaces monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "console": "npm run start -w tools/agent-console"
  }
}
